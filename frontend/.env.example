# =====================================================================
# Frontend env (read by Vite at build/dev time).
# Only variables prefixed with VITE_ are exposed to the browser.
# =====================================================================

# Where the React app calls the backend. In dev (compose) the browser
# talks to localhost:8000; in prod this would be your real API URL
# (e.g. https://api.askmydocs.example.com).
VITE_API_URL=http://localhost:8000
