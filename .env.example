# =====================================================================
# AskMyDocs — root .env (Docker Compose reads this)
# Copy to ".env" and fill in real values for SECRETS only.
# Variables not set here use the defaults baked into backend/core/config.py.
# =====================================================================

# --- Required secrets ---------------------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Frontend ----------------------------------------------------------------
# URL the React app will call. Defaults to localhost:8000 (compose). Set this
# to your real API host when deploying.
# VITE_API_URL=http://localhost:8000

# --- Storage backend ---------------------------------------------------------
# Default is "local" — uploads go to the backend_uploads Docker volume.
# Switch to "s3" + point at LocalStack to exercise the S3 code path locally.
#
#   STORAGE_BACKEND=s3
#   S3_BUCKET=askmydocs-uploads
#   AWS_ENDPOINT_URL=http://localstack:4566
#   AWS_REGION=us-east-1
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
#
# In production (AWS), leave AWS_ENDPOINT_URL empty and use an IAM role
# attached to the ECS task — no AWS_*_KEY needed in env.

# --- Optional overrides (uncomment only if you want a non-default value) ------
# DATABASE_URL is set directly in docker-compose.yml (db:5432). Override here
# only if you want to point at a different database (e.g. cloud RDS).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Auth
# ACCESS_TOKEN_EXPIRE_MINUTES=1440        # default: 24h

# AI models
# EMBEDDING_MODEL=text-embedding-3-small  # default
# EMBEDDING_DIM=1536                      # must match the model
# CHAT_MODEL=gpt-4o-mini                  # default

# Uploads & RAG tuning
# UPLOAD_DIR=uploads                      # default
# MAX_UPLOAD_MB=25                        # default
# CHUNK_SIZE=1000                         # chars per chunk
# CHUNK_OVERLAP=150                       # chars of overlap between chunks
# TOP_K=5                                 # how many chunks to retrieve per question
